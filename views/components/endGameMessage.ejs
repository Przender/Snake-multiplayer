<%
  const footerClassLocal = typeof footerClass !== 'undefined' ? footerClass : '';
  const buttonTextLocal = typeof buttonText !== 'undefined' ? buttonText : 'To Main Menu';
%>

<div class="modal fade" id="<%= id %>" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5"><%= title %></h1>
            </div>

            <div class="modal-body">
                <%= message %>
            </div>

            <div class="modal-footer <%= footerClassLocal %>">
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">
                <%= buttonTextLocal %>
            </button>
            </div>
        </div>
    </div>
</div>