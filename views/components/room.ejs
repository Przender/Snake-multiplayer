<div class="card h-100">
    <div class="card-body d-flex flex-column">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <strong class="<%= active ? '' : 'invisible' %>"><%= name %></strong>
            <button class="btn btn-sm btn-primary room-btn <%= active ? '' : 'invisible' %>" data-id="<%= id %>" data-private="<%= isPrivate %>">
                <%= mode === 'join' ? 'Join' : 'Watch' %>
            </button>
        </div>

        <div class="text-muted small mt-auto <%= active ? '' : 'invisible' %>">
            <%= isPrivate ? 'Private' : 'Public' %><br>
            Watchable: <%= watchable %>
        </div>
    </div>
</div>