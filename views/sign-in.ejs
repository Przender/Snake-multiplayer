<div class="row align-items-center g-lg-5 py-5">
    <div class="col-md-10 mx-auto col-lg-5"> 
        <form action="/sign-in" method="POST" class="p-4 p-md-5 border rounded-3 bg-body-tertiary"> 

            <h1 class="display-7 fw-bold lh-1 text-body-emphasis mb-3">Sign in</h1> 
            <p class="col-lg-10 fs-7">Type in a unique username and password to create an account.</p> 
            
            <div class="form-floating mb-3"> 
                <input type="text" class="form-control" id="login" name="login" value ="<%= locals.login || '' %>"> 
                <label for="floatingInput"> Username</label> 
            </div> 

            <div class="form-floating mb-3"> 
                <input type="password" class="form-control" id="password" name="password"> 
                <label for="floatingPassword">Password</label> 
            </div>

            <div class="form-floating mb-3"> 
                <input type="password" class="form-control" id="confirm" name="confirm"> 
                <label for="floatingPassword">Confirm password</label> 
            </div>

            <%- include('./components/badLoginPopup', { title: "Incorrect sign-in", loginError: locals.loginError }) %>

            <div class="checkbox mb-3"> 
                <label> 
                    <input type="checkbox" value="remember-me" name="remember"> Remember me
                </label> 
            </div>

            <button class="w-100 btn btn-lg btn-primary" type="submit">Sign in</button> 
            <hr class="my-4"> 
            <small class="text-body-secondary">
                If you already have an account, 
                <a class="text-body-secondary" href="/login">Log in</a>
            </small>
        </form> 
    </div> 
</div>